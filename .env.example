# ========== 必填：LLM API配置 ==========
# DeepSeek API Key（用于旋律创作Agent）
DEEPSEEK_API_KEY=sk-your-key-here

# ========== 可选：默认值已够用 ==========
# DeepSeek API地址（默认：https://api.deepseek.com）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek模型名（默认：deepseek-v4-flash，可选deepseek-v4-pro）
# DEEPSEEK_MODEL=deepseek-v4-flash
